      "html": "<div class=\"ds-scenarios\"><label for=\"ds-scenario\">Тестовый сценарий</label><select id=\"ds-scenario\"><option value=\"violation\">Одно событие</option><option value=\"no_violation\">Нет событий</option><option value=\"multiple_events\">Несколько событий</option><option value=\"three_frames\">Три кадра у события</option><option value=\"long_text\">Длинные названия и описания</option><option value=\"demo_rule\">Вымышленный источник</option><option value=\"slow\">Медленная обработка</option><option value=\"ml_error\">Ошибка ML</option><option value=\"invalid_ml_response\">Некорректный ответ ML</option></select></div>",
