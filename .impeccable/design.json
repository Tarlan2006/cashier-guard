  "narrative": {
    "northStar": "Calm daytime review desk",
    "overview": "This describes the implemented Operate scaffold: deep green navigation, warm near-white surroundings, white work panels, and restrained status colors. It is a code-led direction recorded after implementation, not an approved concept seed or image comp.\n\nThe interface is compact and task-focused. Evidence, status, and controls share locally bundled Manrope and consistent Lucide SVG icons. Demo and possible-event notices remain explicit; color supports their written meaning.",
    "keyCharacteristics": [
      "Deep green navigation with quiet white work surfaces.",
      "Compact typography, fine borders, and gently rounded controls.",
      "Written status labels and actual video evidence."
    ],
    "rules": [
      {
        "name": "The Written Status Rule",
        "body": "Pair status color with a written label and the corresponding icon or indicator.",
        "section": "colors"
      },
      {
        "name": "The Flat Panel Rule",
        "body": "Separate work panels with surface color and a fine border; reserve the existing shallow shadow for the selected scenario segment.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve explicit demo and human-review language in status treatments.",
      "Do retain visible keyboard focus and reduced-motion behavior.",
      "Do use tabular numerals for timestamps and file metadata."
    ],
    "donts": [
      "Don't communicate a verdict through color alone.",
      "Don't replace actual evidence frames with decorative imagery.",
      "Don't infer a general display-text style from the smallest metadata captions."
    ]
  }
}
