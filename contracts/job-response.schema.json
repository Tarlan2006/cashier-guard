{
  "$defs": {
    "EvidenceFrame": {
      "properties": {
        "timestamp_sec": {
          "minimum": 0,
          "title": "Timestamp Sec",
          "type": "number"
        },
        "image_base64": {
          "maxLength": 4000000,
          "minLength": 4,
          "title": "Image Base64",
          "type": "string"
        }
      },
      "required": [
        "timestamp_sec",
        "image_base64"
      ],
      "title": "EvidenceFrame",
      "type": "object"
    },
    "Rule": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "visual_signs": {
          "items": {
            "type": "string"
          },
          "title": "Visual Signs",
          "type": "array"
        },
        "document": {
          "title": "Document",
          "type": "string"
        },
        "section": {
          "title": "Section",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "visual_signs",
        "document",
        "section",
        "url"
      ],
      "title": "Rule",
      "type": "object"
    },
    "Violation": {
      "properties": {
        "type": {
          "minLength": 1,
          "title": "Type",
          "type": "string"
        },
        "timecode_sec": {
          "minimum": 0,
          "title": "Timecode Sec",
          "type": "number"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "evidence_frames": {
          "items": {
            "$ref": "#/$defs/EvidenceFrame"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Evidence Frames",
          "type": "array"
        },
        "rule_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule Id"
        },
        "rule": {
          "anyOf": [
            {
              "$ref": "#/$defs/Rule"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "type",
        "timecode_sec",
        "description",
        "evidence_frames"
      ],
      "title": "Violation",
      "type": "object"
    }
  },
  "properties": {
    "job_id": {
      "title": "Job Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "processing",
        "done",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "stage": {
      "enum": [
        "queued",
        "preparing",
        "analyzing",
        "matching",
        "done",
        "failed"
      ],
      "title": "Stage",
      "type": "string"
    },
    "mode": {
      "enum": [
        "demo",
        "live"
      ],
      "title": "Mode",
      "type": "string"
    },
    "filename": {
      "title": "Filename",
      "type": "string"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "duration_sec": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Duration Sec"
    },
    "verdict": {
      "anyOf": [
        {
          "enum": [
            "violation",
            "no_violation"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Verdict"
    },
    "violations": {
      "items": {
        "$ref": "#/$defs/Violation"
      },
      "title": "Violations",
      "type": "array"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    }
  },
  "required": [
    "job_id",
    "status",
    "stage",
    "mode",
    "filename",
    "created_at"
  ],
  "title": "JobResponse",
  "type": "object"
}
