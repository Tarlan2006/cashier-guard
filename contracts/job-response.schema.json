{
  "$defs": {
    "EvidenceFrame": {
      "properties": {
        "timestamp_sec": {
          "minimum": 0,
          "title": "Timestamp Sec",
          "type": "number"
        },
        "image_base64": {
          "maxLength": 4000000,
          "minLength": 4,
          "title": "Image Base64",
          "type": "string"
        }
      },
      "required": [
        "timestamp_sec",
        "image_base64"
      ],
      "title": "EvidenceFrame",
      "type": "object"
    },
    "HumanReview": {
      "properties": {
        "decision": {
          "default": "unreviewed",
          "enum": [
            "unreviewed",
            "confirmed",
            "rejected"
          ],
          "title": "Decision",
          "type": "string"
        },
        "comment": {
          "default": "",
          "maxLength": 4000,
          "title": "Comment",
          "type": "string"
        },
        "updated_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Updated At"
        }
      },
      "title": "HumanReview",
      "type": "object"
    },
    "ReviewedEvent": {
      "allOf": [
        {
          "if": {
            "properties": {
              "assessment": {
                "const": "strong_evidence"
              }
            },
            "required": [
              "assessment"
            ]
          },
          "then": {
            "properties": {
              "assessment_reason": {
                "minLength": 1,
                "pattern": "\\S",
                "type": "string"
              }
            },
            "required": [
              "assessment_reason"
            ]
          }
        }
      ],
      "properties": {
        "type": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Type",
          "type": "string"
        },
        "timecode_sec": {
          "minimum": 0,
          "title": "Timecode Sec",
          "type": "number"
        },
        "description": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "evidence_frames": {
          "items": {
            "$ref": "#/$defs/EvidenceFrame"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Evidence Frames",
          "type": "array"
        },
        "rule_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule Id"
        },
        "rule": {
          "anyOf": [
            {
              "$ref": "#/$defs/Rule"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "assessment": {
          "anyOf": [
            {
              "enum": [
                "strong_evidence",
                "needs_review"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ML2 evidence assessment. Missing/null is legacy: display needs_review without inventing an assessment.",
          "title": "Assessment"
        },
        "assessment_reason": {
          "anyOf": [
            {
              "maxLength": 8000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ML2 explanation of the assessment. Required for strong_evidence; never a confidence percentage.",
          "title": "Assessment Reason"
        },
        "event_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Event Id"
        },
        "category_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Category Id"
        },
        "human_review": {
          "anyOf": [
            {
              "$ref": "#/$defs/HumanReview"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "type",
        "timecode_sec",
        "description",
        "evidence_frames"
      ],
      "title": "ReviewedEvent",
      "type": "object"
    },
    "Rule": {
      "properties": {
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "title": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "visual_signs": {
          "items": {
            "maxLength": 8000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Visual Signs",
          "type": "array"
        },
        "document": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Document",
          "type": "string"
        },
        "section": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Section",
          "type": "string"
        },
        "url": {
          "format": "uri",
          "maxLength": 2048,
          "minLength": 1,
          "pattern": "^https?://",
          "title": "Url",
          "type": "string"
        },
        "is_demo": {
          "default": false,
          "title": "Is Demo",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "title",
        "visual_signs",
        "document",
        "section",
        "url"
      ],
      "title": "Rule",
      "type": "object"
    }
  },
  "properties": {
    "job_id": {
      "title": "Job Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "processing",
        "done",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "stage": {
      "enum": [
        "queued",
        "preparing",
        "analyzing",
        "matching",
        "done",
        "failed"
      ],
      "title": "Stage",
      "type": "string"
    },
    "mode": {
      "enum": [
        "demo",
        "live"
      ],
      "title": "Mode",
      "type": "string"
    },
    "filename": {
      "title": "Filename",
      "type": "string"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "duration_sec": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Duration Sec"
    },
    "source_time_offset_sec": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Original container timeline origin. Add to normalized event time for source media timestamps; browsers may rebase their playback timeline. Null for older jobs.",
      "title": "Source Time Offset Sec"
    },
    "size_bytes": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Size Bytes"
    },
    "verdict": {
      "anyOf": [
        {
          "enum": [
            "violation",
            "no_violation"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Verdict"
    },
    "violations": {
      "items": {
        "$ref": "#/$defs/ReviewedEvent"
      },
      "title": "Violations",
      "type": "array"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "error_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Code"
    },
    "timings_sec": {
      "additionalProperties": {
        "minimum": 0,
        "type": "number"
      },
      "title": "Timings Sec",
      "type": "object"
    },
    "expires_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expires At"
    },
    "deadline_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Deadline At"
    },
    "demo_scenario": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Demo Scenario"
    },
    "completed_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completed At"
    },
    "video_available": {
      "default": false,
      "title": "Video Available",
      "type": "boolean"
    },
    "video_expires_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Video Expires At"
    },
    "video_size_bytes": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Video Size Bytes"
    },
    "video_unavailable_reason": {
      "anyOf": [
        {
          "enum": [
            "expired",
            "missing",
            "not_retained"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Video Unavailable Reason"
    }
  },
  "required": [
    "job_id",
    "status",
    "stage",
    "mode",
    "filename",
    "created_at"
  ],
  "title": "JobResponse",
  "type": "object"
}
