{
  "$defs": {
    "EvidenceFrame": {
      "properties": {
        "timestamp_sec": {
          "minimum": 0,
          "title": "Timestamp Sec",
          "type": "number"
        },
        "image_base64": {
          "maxLength": 4000000,
          "minLength": 4,
          "title": "Image Base64",
          "type": "string"
        }
      },
      "required": [
        "timestamp_sec",
        "image_base64"
      ],
      "title": "EvidenceFrame",
      "type": "object"
    },
    "QueueEvent": {
      "properties": {
        "job_id": {
          "title": "Job Id",
          "type": "string"
        },
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "category_id": {
          "title": "Category Id",
          "type": "string"
        },
        "type": {
          "title": "Type",
          "type": "string"
        },
        "timecode_sec": {
          "minimum": 0,
          "title": "Timecode Sec",
          "type": "number"
        },
        "filename": {
          "title": "Filename",
          "type": "string"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "mode": {
          "enum": [
            "demo",
            "live"
          ],
          "title": "Mode",
          "type": "string"
        },
        "frame": {
          "anyOf": [
            {
              "$ref": "#/$defs/EvidenceFrame"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "job_id",
        "event_id",
        "category_id",
        "type",
        "timecode_sec",
        "filename",
        "tags",
        "created_at",
        "mode"
      ],
      "title": "QueueEvent",
      "type": "object"
    }
  },
  "properties": {
    "items": {
      "items": {
        "$ref": "#/$defs/QueueEvent"
      },
      "title": "Items",
      "type": "array"
    },
    "total": {
      "title": "Total",
      "type": "integer"
    },
    "total_events": {
      "title": "Total Events",
      "type": "integer"
    },
    "reviewed_events": {
      "title": "Reviewed Events",
      "type": "integer"
    },
    "page": {
      "title": "Page",
      "type": "integer"
    },
    "page_size": {
      "title": "Page Size",
      "type": "integer"
    }
  },
  "required": [
    "items",
    "total",
    "total_events",
    "reviewed_events",
    "page",
    "page_size"
  ],
  "title": "ReviewQueuePage",
  "type": "object"
}
