{
  "$defs": {
    "EvidenceFrame": {
      "properties": {
        "timestamp_sec": {
          "minimum": 0,
          "title": "Timestamp Sec",
          "type": "number"
        },
        "image_base64": {
          "maxLength": 4000000,
          "minLength": 4,
          "title": "Image Base64",
          "type": "string"
        }
      },
      "required": [
        "timestamp_sec",
        "image_base64"
      ],
      "title": "EvidenceFrame",
      "type": "object"
    },
    "Rule": {
      "properties": {
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "title": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "visual_signs": {
          "items": {
            "maxLength": 8000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Visual Signs",
          "type": "array"
        },
        "document": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Document",
          "type": "string"
        },
        "section": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Section",
          "type": "string"
        },
        "url": {
          "format": "uri",
          "maxLength": 2048,
          "minLength": 1,
          "pattern": "^https?://",
          "title": "Url",
          "type": "string"
        },
        "is_demo": {
          "default": false,
          "title": "Is Demo",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "title",
        "visual_signs",
        "document",
        "section",
        "url"
      ],
      "title": "Rule",
      "type": "object"
    },
    "Violation": {
      "properties": {
        "type": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Type",
          "type": "string"
        },
        "timecode_sec": {
          "minimum": 0,
          "title": "Timecode Sec",
          "type": "number"
        },
        "description": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "evidence_frames": {
          "items": {
            "$ref": "#/$defs/EvidenceFrame"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Evidence Frames",
          "type": "array"
        },
        "rule_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule Id"
        },
        "rule": {
          "anyOf": [
            {
              "$ref": "#/$defs/Rule"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "type",
        "timecode_sec",
        "description",
        "evidence_frames"
      ],
      "title": "Violation",
      "type": "object"
    }
  },
  "properties": {
    "verdict": {
      "enum": [
        "violation",
        "no_violation"
      ],
      "title": "Verdict",
      "type": "string"
    },
    "violations": {
      "items": {
        "$ref": "#/$defs/Violation"
      },
      "maxItems": 100,
      "title": "Violations",
      "type": "array"
    }
  },
  "required": [
    "verdict"
  ],
  "title": "AnalysisResult",
  "type": "object"
}
