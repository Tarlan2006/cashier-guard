          "title": "Decision",
          "type": "string"
        },
        "comment": {
          "default": "",
          "maxLength": 4000,
          "title": "Comment",
          "type": "string"
        },
        "updated_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Updated At"
        }
      },
      "title": "HumanReview",
      "type": "object"
    },
    "ReviewLogEntry": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "integer"
        },
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "type": {
          "title": "Type",
          "type": "string"
        },
        "changed_at": {
          "title": "Changed At",
          "type": "string"
        },
        "previous": {
          "anyOf": [
            {
              "$ref": "#/$defs/HumanReview"
