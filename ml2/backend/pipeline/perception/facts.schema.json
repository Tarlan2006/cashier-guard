{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local perception timeline",
  "type": "object",
  "required": ["schema_version", "video", "sample_interval_sec", "coordinate_system", "model", "frames"],
  "allOf": [{
    "if": {"properties": {"schema_version": {"enum": ["1.1", "1.2", "1.3", "1.4"]}}},
    "then": {
      "required": ["fixtures", "reflection_tracks", "refinement"],
      "properties": {"frames": {"items": {
        "required": ["people_count", "reflection_count", "counter_machine"],
        "properties": {"persons": {"items": {
          "required": ["is_reflection", "reflection_reason", "reflection_evidence"]
        }}}
      }}}
    }
  }],
  "properties": {
    "schema_version": {"enum": ["1.0", "1.1", "1.2", "1.3", "1.4"]},
    "sample_interval_sec": {"const": 0.5},
    "sampling_interval_by_time": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0.5}},
    "runtime": {"type": "object", "properties": {
      "complete": {"type": "boolean"},
      "warnings": {"type": "array", "items": {"type": "string"}}
    }},
    "semantic_engine": {"type": "object"},
    "coordinate_system": {"type": "string"},
    "video": {
      "type": "object",
      "required": ["name", "duration_sec", "width", "height", "fps", "rotation_deg", "frame_count"],
      "properties": {
        "name": {"type": "string"},
        "duration_sec": {"type": "number", "exclusiveMinimum": 0},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "fps": {"type": "number", "exclusiveMinimum": 0},
        "rotation_deg": {"enum": [0, 90, 180, 270]},
        "frame_count": {"type": "integer", "minimum": 1}
      }
    },
    "model": {"type": "object"},
    "fixtures": {"type": "array", "items": {"$ref": "#/$defs/fixture"}},
    "reflection_tracks": {"type": "array", "items": {"type": "object"}},
    "events": {"type": "array", "items": {"type": "object", "required": ["type", "timecode_sec", "first_seen", "confirmed_at"]}},
    "frames": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["timestamp_sec", "actual_timestamp_sec", "persons", "objects", "counter"],
        "properties": {
          "timestamp_sec": {"type": "number", "minimum": 0},
          "actual_timestamp_sec": {"type": "number", "minimum": 0},
          "persons": {"type": "array", "items": {"$ref": "#/$defs/person"}},
          "objects": {"type": "array", "items": {"$ref": "#/$defs/object"}},
          "people_count": {"type": "integer", "minimum": 0},
          "reflection_count": {"type": "integer", "minimum": 0},
          "certain_people_count": {"type": "integer", "minimum": 0},
          "uncertain_people_count": {"type": "integer", "minimum": 0},
          "suppressed_persons": {"type": "array", "items": {"type": "object"}},
          "counter_machine": {"oneOf": [{"type": "null"}, {"type": "object", "required": ["bbox"], "properties": {"bbox": {"$ref": "#/$defs/bbox"}}}]},
          "safe": {"oneOf": [{"type": "null"}, {"type": "object", "required": ["bbox"], "properties": {"bbox": {"$ref": "#/$defs/bbox"}}}]},
          "counter": {
            "type": "object", "required": ["status", "changes"],
            "properties": {
              "status": {"enum": ["uncalibrated", "calibrated"]},
              "changes": {"type": "array", "items": {"type": "object", "required": ["kind"]}}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "bbox": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number", "minimum": 0, "maximum": 1}},
    "person": {
      "type": "object", "required": ["id", "role", "bbox", "confidence", "observed", "confirmed", "motion"],
      "properties": {
        "id": {"type": "integer", "minimum": 1},
        "role": {"enum": ["unknown", "cashier_candidate", "visitor_candidate", "client_candidate"]},
        "is_reflection": {"type": "boolean"},
        "counted": {"type": "boolean"},
        "event_eligible": {"type": "boolean"},
        "uncertain": {"type": "boolean"},
        "uncertainty_reason": {"type": ["string", "null"]},
        "status": {"enum": ["reflection", "tentative", "uncertain", "confirmed"]},
        "track_age_sec": {"type": "number", "minimum": 0},
        "source_track_ids": {"type": "array", "items": {"type": "integer", "minimum": 1}},
        "reflection_reason": {"type": ["string", "null"]},
        "reflection_evidence": {"type": "object"},
        "role_reason": {"type": "string"},
        "role_confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "cashier_prob": {"type": "number", "minimum": 0, "maximum": 1},
        "client_prob": {"type": "number", "minimum": 0, "maximum": 1},
        "first_seen": {"type": "number", "minimum": 0},
        "confirmed_at": {"type": ["number", "null"], "minimum": 0},
        "bbox": {"$ref": "#/$defs/bbox"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "observed": {"const": true},
        "confirmed": {"type": "boolean"},
        "motion": {"type": "object"}
      }
    },
    "fixture": {
      "type": "object", "required": ["id", "class", "bbox"],
      "properties": {
        "id": {"type": "integer", "minimum": 1},
        "class": {"enum": ["counter_machine", "safe", "laptop", "phone", "monitor", "bag", "cash_register", "unclassified_fixture"]},
        "bbox": {"$ref": "#/$defs/bbox"}
      }
    },
    "object": {
      "type": "object", "required": ["class", "bbox", "confidence"],
      "properties": {
        "class": {"type": "string"},
        "fixture": {"type": "boolean"},
        "coco_class": {"type": "string"},
        "first_seen": {"type": "number", "minimum": 0},
        "confirmed_at": {"type": ["number", "null"], "minimum": 0},
        "bbox": {"$ref": "#/$defs/bbox"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    }
  }
}
