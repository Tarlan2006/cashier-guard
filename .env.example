# Server configuration only. Never add API_KEY to frontend, VITE_ variables or Git.
# ./scripts/setup.sh creates a random key in .env without printing it.
API_KEY=
PIPELINE_MODE=demo
MAX_UPLOAD_MB=100
# Includes body upload, queue wait, FFmpeg, ML1 and ML2; max 295 seconds.
JOB_TIMEOUT_SECONDS=290
UPLOAD_TIMEOUT_SECONDS=60
WORKERS=2
# Local FFmpeg conversions; also bounded by WORKERS and the shared job deadline.
NORMALIZATION_WORKERS=1
# Per normalized MP4 ceiling; available storage/disk may impose a smaller ceiling.
MAX_NORMALIZED_MB=512
QUEUE_SIZE=16
MAX_CONCURRENT_UPLOADS=2
MAX_STORAGE_MB=2048
MAX_STORED_JOBS=128
RESULT_TTL_HOURS=1
CLEANUP_INTERVAL_SECONDS=60
# Local default: backend/storage. Docker overrides it with /app/storage volume.
# STORAGE_DIR=/absolute/path/to/storage
# RULES_PATH=/absolute/path/to/data/rules.json
# Local services; in Compose replace with ML container DNS names/private addresses.
ML1_URL=http://127.0.0.1:8001
ML2_URL=http://127.0.0.1:8002
# Docker host port only. Local dev script intentionally uses fixed 8000/5173.
PORT=8000
# Optional HTTPS deployment; requires your server, DNS and open ports 80/443.
# DOMAIN=cashier.example.org
# ACME_EMAIL=operator@example.org
# MAX_UPLOAD_MB * 1024 * 1024 + 1048576; keep in sync with MAX_UPLOAD_MB.
PROXY_MAX_BODY_BYTES=105906176
